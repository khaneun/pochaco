[Unit]
Description=pochaco 디스크 가드 (보관기간·용량 버퍼 정리)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/opt/pochaco
Environment="AWS_SECRET_NAME=pochaco/production"
Environment="AWS_REGION=ap-northeast-2"
ExecStart=/opt/pochaco/.venv/bin/python -m ops.disk_guard --app pochaco --data-dir /opt/pochaco/data
MemoryMax=200M
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
