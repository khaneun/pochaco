[Unit]
Description=pochaco 백테스트 1회 실행 (baseline + 텔레그램 보고)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/opt/pochaco
Environment="AWS_SECRET_NAME=pochaco/production"
Environment="AWS_REGION=ap-northeast-2"
Environment="DB_PATH=/opt/pochaco/data/pochaco.db"
# 6/14 이전 실행은 스킵 (캔들 7일 누적 후 1차부터 의미 있음). 조건 미충족 시 깨끗이 스킵
ExecCondition=/bin/sh -c 'test "$(date -u +%%Y%%m%%d)" -ge 20260614'
ExecStart=/opt/pochaco/.venv/bin/python -m backtest.cli --scenario baseline --candles /opt/pochaco/data/candles.db --telegram
ExecStart=/opt/pochaco/.venv/bin/python -m backtest.cli --scenario compare --candles /opt/pochaco/data/candles.db --telegram
StandardOutput=journal
StandardError=journal
