[Unit]
Description=kuromi 백테스트 캔들 수집기 (Upbit 5분봉 누적)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kuromi
# EXCHANGE_PROVIDER 등 설정은 AWS Secrets Manager에서 로드 (운영 서비스와 동일)
Environment="AWS_SECRET_NAME=kuromi/prod"
Environment="AWS_REGION=ap-northeast-2"
ExecStart=/opt/kuromi/.venv/bin/python -m backtest.data_collector
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
